{% include "helpers/int_divider.slang.j2" %}

[[vk::constant_id(0)]] const uint OP_TYPE = 0;
[[vk::constant_id(1)]] const uint IS_CONTIG = 0;
[[vk::constant_id(2)]] const uint USE_SCALAR = 0;
[[vk::constant_id(3)]] const uint NDIM = 0;
[[vk::constant_id(4)]] const uint WG_x = 0;

struct Metadata
{
    uint64_t sizes;
    uint64_t strides_a;
    uint64_t strides_b;
    uint64_t strides_out;
};

struct PushConstants
{
    uint64_t tensor_a;
    uint64_t tensor_b;
    uint64_t tensor_out;
    uint64_t metadata;
    uint64_t numel;
    {{ d1 }} scalar_value;
};

[[vk::push_constant]] ConstantBuffer<PushConstants> pcs;

interface ICompareOp
{
    static uint8_t eval({{ d1 }} a, {{ d1 }} b);
}

struct EqOp : ICompareOp
{
    static uint8_t eval({{ d1 }} a, {{ d1 }} b) { return (a == b) ? uint8_t(1) : uint8_t(0); }
}

struct NeOp : ICompareOp
{
    static uint8_t eval({{ d1 }} a, {{ d1 }} b) { return (a != b) ? uint8_t(1) : uint8_t(0); }
}

struct LtOp : ICompareOp
{
    static uint8_t eval({{ d1 }} a, {{ d1 }} b) { return (a < b) ? uint8_t(1) : uint8_t(0); }
}

struct LeOp : ICompareOp
{
    static uint8_t eval({{ d1 }} a, {{ d1 }} b) { return (a <= b) ? uint8_t(1) : uint8_t(0); }
}

struct GtOp : ICompareOp
{
    static uint8_t eval({{ d1 }} a, {{ d1 }} b) { return (a > b) ? uint8_t(1) : uint8_t(0); }
}

struct GeOp : ICompareOp
{
    static uint8_t eval({{ d1 }} a, {{ d1 }} b) { return (a >= b) ? uint8_t(1) : uint8_t(0); }
}

struct LogicalAndOp : ICompareOp
{
    static uint8_t eval({{ d1 }} a, {{ d1 }} b) { return (a != {{ d1 }}(0) && b != {{ d1 }}(0)) ? uint8_t(1) : uint8_t(0); }
}

struct LogicalOrOp : ICompareOp
{
    static uint8_t eval({{ d1 }} a, {{ d1 }} b) { return (a != {{ d1 }}(0) || b != {{ d1 }}(0)) ? uint8_t(1) : uint8_t(0); }
}

struct LogicalXorOp : ICompareOp
{
    static uint8_t eval({{ d1 }} a, {{ d1 }} b) { return ((a != {{ d1 }}(0)) != (b != {{ d1 }}(0))) ? uint8_t(1) : uint8_t(0); }
}

void baseCompareKernel<
    Op : ICompareOp
>(
    uint3 gi: SV_DispatchThreadID,
    uint64_t address_a,
    uint64_t address_b,
    uint64_t address_out,
    uint64_t address_metadata,
    uint64_t numel
)
{
    uint idx = gi.x;
    if (idx >= numel) return;

    {{ d1 }}* tensor_a = ({{ d1 }}*)address_a;
    uint8_t* tensor_out = (uint8_t*)address_out;

    uint idx_a = idx, idx_b = idx, idx_out = idx;
    if (IS_CONTIG == 0) 
    {
        Metadata md = *(Metadata*)address_metadata;
        uint* strides_a = (uint*)md.strides_a;
        uint* strides_b = (uint*)md.strides_b;
        uint* strides_out = (uint*)md.strides_out;

        idx_a = 0; idx_b = 0; idx_out = 0;
        uint linear_idx = idx;

        for (uint i = 0; i < NDIM; i++) 
        {
            uint next_linear_idx = fast_div(md.sizes, linear_idx, i, NDIM);
            uint divisor = get_divisor(md.sizes, i);
            uint coord = linear_idx - (next_linear_idx * divisor);
            linear_idx = next_linear_idx;
            idx_a += coord * strides_a[i];
            idx_b += coord * strides_b[i];
            idx_out += coord * strides_out[i];
        }
    }

    {{ d1 }} va = tensor_a[idx_a];

    // the second operand has no address when it is a scalar, so it is only read when it exists
    {{ d1 }} vb = pcs.scalar_value;
    if (USE_SCALAR == 0) 
    {
        {{ d1 }}* tensor_b = ({{ d1 }}*)address_b;
        vb = tensor_b[idx_b];
    }

    tensor_out[idx_out] = Op.eval(va, vb);
}

[shader("compute")]
[numthreads(WG_x, 1, 1)]
void main(uint3 gi: SV_DispatchThreadID) {
    {% for op in OPERATIONS %}
    if (OP_TYPE == {{ op['name'] }}) baseCompareKernel<{{ op['struct'] }}>(
        gi, pcs.tensor_a, pcs.tensor_b, pcs.tensor_out, pcs.metadata, pcs.numel
    );
    {% endfor %}
}
