{% include "helpers/int_divider.slang.j2" %}
{% include "helpers/vulkan_arithmetic.slang.j2" %}

[[vk::constant_id(0)]] const uint OP_TYPE = 0;
[[vk::constant_id(1)]] const uint IS_CONTIG = 0;
[[vk::constant_id(2)]] const uint USE_SCALAR = 0;
[[vk::constant_id(3)]] const uint NDIM = 0;
[[vk::constant_id(4)]] const uint WG_x = 0;

struct Metadata
{
    uint64_t sizes;
    uint64_t strides_a;
    uint64_t strides_b;
    uint64_t strides_out;
};

struct PushConstants
{
    uint64_t tensor_a;
    uint64_t tensor_b;
    uint64_t tensor_out;
    uint64_t metadata;
    uint64_t numel;
    {{ d1 }} alpha;
    {{ d1 }} scalar_value;
};

interface IBinaryOp<T>
{
    static T eval(T a, T b, T alpha);
}

struct AddOp<T : IArithmetic> : IBinaryOp<T>
{
    static T eval(T a, T b, T alpha) { return a + (alpha * b); }
}

struct SubOp<T : IArithmetic> : IBinaryOp<T>
{
    static T eval(T a, T b, T alpha) { return a - (alpha * b); }
}

struct RSubOp<T : IArithmetic> : IBinaryOp<T>
{
    static T eval(T a, T b, T alpha) { return b - (alpha * a); }
}

struct MulOp<T : IArithmetic> : IBinaryOp<T>
{
    static T eval(T a, T b, T alpha) { return a * b; }
}

struct DivOp<T : IArithmetic> : IBinaryOp<T>
{
    static T eval(T a, T b, T alpha) { return a / b; }
}

struct PowOp<T : IVulkanArithmetic> : IBinaryOp<T>
{
    static T eval(T a, T b, T alpha) { return T.ext_pow(a, b); }
}

struct RPowOp<T : IVulkanArithmetic> : IBinaryOp<T>
{
    static T eval(T a, T b, T alpha) { return T.ext_pow(b, a); }
}

struct Atan2Op<T : IVulkanFloat> : IBinaryOp<T>
{
    static T eval(T a, T b, T alpha) { return T.ext_atan2(a, b); }
}

struct MaxOp<T : IVulkanArithmetic> : IBinaryOp<T>
{
    static T eval(T a, T b, T alpha) { return T.ext_max(a, b); }
}

struct MinOp<T : IVulkanArithmetic> : IBinaryOp<T>
{
    static T eval(T a, T b, T alpha) { return T.ext_min(a, b); }
}

struct ThresholdBackwardOp<T : IVulkanArithmetic> : IBinaryOp<T>
{
    static T eval(T a, T b, T alpha) { return T.ext_threshold_backward(a, b, alpha); }
}

struct FmaxOp<T : IVulkanArithmetic> : IBinaryOp<T>
{
    static T eval(T a, T b, T alpha) { return T.ext_fmax(a, b); }
}

struct FminOp<T : IVulkanArithmetic> : IBinaryOp<T>
{
    static T eval(T a, T b, T alpha) { return T.ext_fmin(a, b); }
}

struct FmodOp<T : IVulkanArithmetic> : IBinaryOp<T>
{
    static T eval(T a, T b, T alpha) { return T.ext_fmod(a, b); }
}

struct RemainderOp<T : IVulkanArithmetic> : IBinaryOp<T>
{
    static T eval(T a, T b, T alpha) { return T.ext_remainder(a, b); }
}

struct HypotOp<T : IVulkanFloat> : IBinaryOp<T>
{
    static T eval(T a, T b, T alpha) { return T.ext_hypot(a, b); }
}

struct XlogyOp<T : IVulkanFloat> : IBinaryOp<T>
{
    static T eval(T a, T b, T alpha) { return T.ext_xlogy(a, b); }
}

struct LogaddexpOp<T : IVulkanFloat> : IBinaryOp<T>
{
    static T eval(T a, T b, T alpha) { return T.ext_logaddexp(a, b); }
}

struct Logaddexp2Op<T : IVulkanFloat> : IBinaryOp<T>
{
    static T eval(T a, T b, T alpha) { return T.ext_logaddexp2(a, b); }
}

void baseBinaryKernel<
    T,
    Op : IBinaryOp<T>,
    let VEC_SIZE : uint
>(
    uint3 gi: SV_DispatchThreadID,
    uint64_t address_a,
    uint64_t address_b,
    uint64_t address_out,
    uint64_t address_metadata,
    uint64_t numel,
    T alpha, T scalar_value
)
{
    uint idx = gi.x;

    if (IS_CONTIG != 0)
    {
        if (idx * VEC_SIZE >= numel) return;

        vector<T, VEC_SIZE>* v_tensor_a = (vector<T, VEC_SIZE>*)address_a;
        vector<T, VEC_SIZE>* v_tensor_out = (vector<T, VEC_SIZE>*)address_out;

        vector<T, VEC_SIZE> va = v_tensor_a[idx];
        vector<T, VEC_SIZE> vb = vector<T, VEC_SIZE>(scalar_value);
        vector<T, VEC_SIZE> res;

        // the second operand has no address when it is a scalar, so it is only read when it exists
        if (USE_SCALAR == 0) 
        {
            vector<T, VEC_SIZE>* v_tensor_b = (vector<T, VEC_SIZE>*)address_b;
            vb = v_tensor_b[idx];
        }

        [unroll] for (int k = 0; k < VEC_SIZE; k++) 
        {
            res[k] = Op.eval(va[k], vb[k], alpha);
        }

        uint64_t remainder = numel - (idx * VEC_SIZE);
        if (remainder >= VEC_SIZE) 
        { 
            v_tensor_out[idx] = res; 
        }
        else 
        {
            T* tensor_out = (T*)address_out;
            for (uint i = 0; i < remainder; i++) { 
                tensor_out[idx * VEC_SIZE + i] = res[i]; 
            }
        }
    }
    else
    {
        if (idx >= numel) return;

        T* tensor_a = (T*)address_a;
        T* tensor_out = (T*)address_out;

        Metadata md = *(Metadata*)address_metadata;
        uint* strides_a = (uint*)md.strides_a;
        uint* strides_b = (uint*)md.strides_b;
        uint* strides_out = (uint*)md.strides_out;

        uint idx_a = 0;
        uint idx_b = 0;
        uint idx_out = 0;
        uint linear_idx = idx;

        for (uint i = 0; i < NDIM; i++) 
        {
            uint next_linear_idx = fast_div(md.sizes, linear_idx, i, NDIM);
            uint divisor = get_divisor(md.sizes, i);
            uint coord = linear_idx - (next_linear_idx * divisor);
            linear_idx = next_linear_idx;
            idx_a += coord * strides_a[i];
            idx_b += coord * strides_b[i];
            idx_out += coord * strides_out[i];
        }

        T v1 = tensor_a[idx_a];
        T v2 = scalar_value;
        if (USE_SCALAR == 0) 
        {
            T* tensor_b = (T*)address_b;
            v2 = tensor_b[idx_b];
        }

        tensor_out[idx_out] = Op.eval(v1, v2, alpha);
    }
}

[[vk::push_constant]] ConstantBuffer<PushConstants> pcs;

[shader("compute")]
[numthreads(WG_x, 1, 1)]
void main(uint3 gi: SV_DispatchThreadID)
{
    {% for op in OPERATIONS %}
    {% if 'float' in d1 or not op.get('float_only') %}

    if (OP_TYPE == {{ op['name'] }})
    {
        baseBinaryKernel<
            {{ d1 }}, 
            {{ op['struct'] }}<{{ d1 }}>, 
            {{ v1 }}
        >(
            gi, pcs.tensor_a, pcs.tensor_b, pcs.tensor_out, pcs.metadata, pcs.numel, pcs.alpha, pcs.scalar_value
        );
    }

    {% endif %}
    {% endfor %}
}
