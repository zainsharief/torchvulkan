{% include "helpers/int_divider.slang.j2" %}
{% include "helpers/vulkan_arithmetic.slang.j2" %}

[[vk::constant_id(0)]] const uint OP_TYPE = 0;
[[vk::constant_id(1)]] const uint NDIM = 0;
[[vk::constant_id(2)]] const uint WG_x = 0;

struct Metadata
{
    uint64_t sizes;
    uint64_t strides_in;
    uint64_t strides_out;
};

struct PushConstants
{
    uint64_t tensor_in;
    uint64_t tensor_out;
    uint64_t metadata;
    uint64_t num_lines;
    uint scan_size;
    uint scan_stride_in;
    uint scan_stride_out;
};

[[vk::push_constant]] ConstantBuffer<PushConstants> pcs;

interface ICumScanOp<T>
{
    static T identity();
    static T combine(T a, T b);
}

struct SumScanOp<T : IVulkanArithmetic> : ICumScanOp<T>
{
    static T identity() { return T.ext_zero(); }
    static T combine(T a, T b) { return T.ext_add(a, b); }
}

struct ProdScanOp<T : IVulkanArithmetic> : ICumScanOp<T>
{
    static T identity() { return T.ext_one(); }
    static T combine(T a, T b) { return T.ext_mul(a, b); }
}

groupshared {{ d1 }} smem[WG_x];

void scanKernel<
    Op : ICumScanOp<{{ d1 }}>
>(
    uint line,
    uint lane,
    uint64_t address_in,
    uint64_t address_out,
    uint64_t address_metadata,
    uint64_t num_lines,
    uint scan_size,
    uint scan_stride_in,
    uint scan_stride_out
)
{
    if (line >= num_lines || scan_size == 0) return;

    {{ d1 }}* tensor_in = ({{ d1 }}*)address_in;
    {{ d1 }}* tensor_out = ({{ d1 }}*)address_out;

    Metadata md = *(Metadata*)address_metadata;
    uint* strides_in = (uint*)md.strides_in;
    uint* strides_out = (uint*)md.strides_out;

    uint base_in = 0;
    uint base_out = 0;
    uint linear_idx = line;

    for (uint i = 0; i < NDIM; i++)
    {
        uint next_linear_idx = fast_div(md.sizes, linear_idx, i, NDIM);
        uint divisor = get_divisor(md.sizes, i);
        uint coord = linear_idx - (next_linear_idx * divisor);
        linear_idx = next_linear_idx;
        base_in += coord * strides_in[i];
        base_out += coord * strides_out[i];
    }

    {{ d1 }} carry = Op.identity();

    for (uint chunk_start = 0; chunk_start < scan_size; chunk_start += WG_x)
    {
        // make sure every thread is done reading last chunk's smem before we overwrite it
        GroupMemoryBarrierWithGroupSync();

        uint j = chunk_start + lane;
        {{ d1 }} value = (j < scan_size) ? tensor_in[base_in + j * scan_stride_in] : Op.identity();
        smem[lane] = value;
        GroupMemoryBarrierWithGroupSync();

        [loop] for (uint step = 1; step < WG_x; step *= 2)
        {
            {{ d1 }} v = smem[lane];
            if (lane >= step) v = Op.combine(smem[lane - step], smem[lane]);
            GroupMemoryBarrierWithGroupSync(); // every lane has read before any lane writes
            smem[lane] = v;
            GroupMemoryBarrierWithGroupSync(); // every lane sees this step's result before the next
        }

        if (j < scan_size) tensor_out[base_out + j * scan_stride_out] = Op.combine(carry, smem[lane]);

        uint last_lane = min(WG_x, scan_size - chunk_start) - 1;
        carry = Op.combine(carry, smem[last_lane]);
    }
}

[shader("compute")]
[numthreads(WG_x, 1, 1)]
void main(uint3 group_id: SV_GroupID, uint3 group_thread_id: SV_GroupThreadID) {
    {% for op in OPERATIONS %}
    if (OP_TYPE == {{ op['name'] }}) scanKernel<{{ op['struct'] }}<{{ d1 }}>>(
        group_id.x, group_thread_id.x, pcs.tensor_in, pcs.tensor_out, pcs.metadata, pcs.num_lines, pcs.scan_size, pcs.scan_stride_in, pcs.scan_stride_out
    );
    {% endfor %}
}
