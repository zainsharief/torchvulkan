[[vk::constant_id(0)]] const uint WORKGROUP_SIZE = 128;
[[vk::constant_id(1)]] const uint SUBGROUP_SIZE = 32;
[[vk::constant_id(2)]] const uint WARPS_M = 2;
[[vk::constant_id(3)]] const uint WARPS_N = 2;
[[vk::constant_id(4)]] const uint WARP_FRAGS_M = 2;
[[vk::constant_id(5)]] const uint WARP_FRAGS_N = 2;
[[vk::constant_id(6)]] const uint BK = 16;

[[vk::constant_id(7)]] const uint HAS_ALPHA = 0;
[[vk::constant_id(8)]] const uint HAS_BETA = 0;
[[vk::constant_id(9)]] const uint HAS_BIAS = 0;

[[vk::constant_id(10)]] const uint A_TRANSPOSED = 0;
[[vk::constant_id(11)]] const uint B_TRANSPOSED = 0;
[[vk::constant_id(12)]] const uint OUT_TRANSPOSED = 0;
[[vk::constant_id(13)]] const uint BIAS_TRANSPOSED = 0;

[[vk::constant_id(14)]] const uint M_ALIGNED = 0;
[[vk::constant_id(15)]] const uint N_ALIGNED = 0;

[[vk::constant_id(16)]] const uint A_VEC_ALIGNED = 0;
[[vk::constant_id(17)]] const uint B_VEC_ALIGNED = 0;

#define PAD 4

struct TensorStrides {
    uint batch;
    uint row;
    uint col;
    uint padding;
};

struct PushConstants {
    uint64_t tensor_a;
    uint64_t tensor_b;
    uint64_t tensor_out;
    uint64_t tensor_bias;
    TensorStrides strides_a;
    TensorStrides strides_b;
    TensorStrides strides_out;
    TensorStrides strides_bias;
    uint m_dim;
    uint n_dim;
    uint k_dim;
    uint padding;
    {{ d1 }} alpha;
    {{ d1 }} beta;
};

[[vk::push_constant]] ConstantBuffer<PushConstants> pcs;

{% if os != 'darwin' %}
// we double buffer shared memory to avoid GPU starvation
groupshared {{ d1 }} smemA[2 * (WARPS_M * WARP_FRAGS_M * {{ BLOCK_SIZE }}) * (BK + PAD)];
groupshared {{ d1 }} smemB[2 * BK * ((WARPS_N * WARP_FRAGS_N * {{ BLOCK_SIZE }}) + PAD)];
{% else %}
// use shared memory to prevent overflow writes 
groupshared {{ d1 }} smemTailA[(WARPS_M * WARP_FRAGS_M * {{ BLOCK_SIZE }}) * BK];
groupshared {{ d1 }} smemTailB[BK * (WARPS_N * WARP_FRAGS_N * {{ BLOCK_SIZE }})];
{% endif %}

void matmulKernel<
    let block_size: uint,
    let block_size_acc: uint, 
    let warp_frags_m: uint, 
    let warp_frags_n: uint,
>(
    uint3 wg: SV_GroupID,
    uint ti: SV_GroupIndex,
    {{ d1 }}* tensor_a,
    {{ d1 }}* tensor_b,
    {{ d1 }}* tensor_out,
    {{ d1 }}* tensor_bias,
    vector<{{ d1 }}, {{ v1 }}>* tensor_a_vec,
    vector<{{ d1 }}, {{ v1 }}>* tensor_b_vec,
    vector<{{ d1 }}, {{ v1 }}>* tensor_out_vec,
    vector<{{ d1 }}, {{ v1 }}>* tensor_bias_vec
)
{
    uint batch_offset_a = wg.z * pcs.strides_a.batch;
    uint batch_offset_b = wg.z * pcs.strides_b.batch;
    uint batch_offset_out = wg.z * pcs.strides_out.batch;

    uint tile_m = wg.y * (WARPS_M * warp_frags_m * block_size);
    uint tile_n = wg.x * (WARPS_N * warp_frags_n * block_size);

    uint warp_id  = ti / SUBGROUP_SIZE;
    uint warp_row = warp_id / WARPS_N;
    uint warp_col = warp_id % WARPS_N;
    uint warp_row_base = warp_row * warp_frags_m * block_size;
    uint warp_col_base = warp_col * warp_frags_n * block_size;
    uint total_threads = WARPS_M * WARPS_N * SUBGROUP_SIZE;

    linalg::CoopMat<{{ d1 }}, MemoryScope.Subgroup, block_size, block_size, linalg::CoopMatMatrixUse.MatrixAccumulator> acc[warp_frags_m * warp_frags_n];

    [ForceUnroll] for (uint mi = 0; mi < warp_frags_m; ++mi) 
    {
        [ForceUnroll] for (uint nj = 0; nj < warp_frags_n; ++nj) 
        {
            uint flat_idx = mi * warp_frags_n + nj;
            acc[flat_idx] = linalg::CoopMat<{{ d1 }}, MemoryScope.Subgroup, block_size, block_size, linalg::CoopMatMatrixUse.MatrixAccumulator>(0);
        }
    }

    GroupMemoryBarrierWithGroupSync();

    {% if os == 'darwin' %}

    uint a_rows[warp_frags_m];
    [ForceUnroll] for (uint mi = 0; mi < warp_frags_m; ++mi)
    {
        a_rows[mi] = tile_m + warp_row_base + mi * block_size;
        if (M_ALIGNED == 0) a_rows[mi] = min(a_rows[mi], pcs.m_dim - 1);
    }
    uint b_cols[warp_frags_n];
    [ForceUnroll] for (uint nj = 0; nj < warp_frags_n; ++nj)
    {
        b_cols[nj] = tile_n + warp_col_base + nj * block_size;
        if (N_ALIGNED == 0) b_cols[nj] = min(b_cols[nj], pcs.n_dim - 1);
    }

    uint k_main_end = (pcs.k_dim / BK) * BK;
    uint k = 0;

    for (; k + 8 * block_size_acc <= k_main_end; k += 8 * block_size_acc)
    {
        linalg::CoopMat<{{ d1 }}, MemoryScope.Subgroup, block_size, block_size_acc, linalg::CoopMatMatrixUse.MatrixA> matA8[8][warp_frags_m];
        [ForceUnroll] for (uint s = 0; s < 8; ++s)
        {
            [ForceUnroll] for (uint mi = 0; mi < warp_frags_m; ++mi)
            {
                uint idx = batch_offset_a + a_rows[mi] * pcs.strides_a.row + (k + s * block_size_acc) * pcs.strides_a.col;
                if (A_TRANSPOSED == 1) {
                    matA8[s][mi] = matA8[s][mi].Load<linalg::CoopMatMatrixLayout.ColumnMajor>(tensor_a, idx, pcs.strides_a.col);
                } else {
                    matA8[s][mi] = matA8[s][mi].Load<linalg::CoopMatMatrixLayout.RowMajor>(tensor_a, idx, pcs.strides_a.row);
                }
            }
        }

        linalg::CoopMat<{{ d1 }}, MemoryScope.Subgroup, block_size_acc, block_size, linalg::CoopMatMatrixUse.MatrixB> matB8[8][warp_frags_n];
        [ForceUnroll] for (uint s = 0; s < 8; ++s)
        {
            [ForceUnroll] for (uint nj = 0; nj < warp_frags_n; ++nj)
            {
                uint idx = batch_offset_b + (k + s * block_size_acc) * pcs.strides_b.row + b_cols[nj] * pcs.strides_b.col;
                if (B_TRANSPOSED == 1) {
                    matB8[s][nj] = matB8[s][nj].Load<linalg::CoopMatMatrixLayout.ColumnMajor>(tensor_b, idx, pcs.strides_b.col);
                } else {
                    matB8[s][nj] = matB8[s][nj].Load<linalg::CoopMatMatrixLayout.RowMajor>(tensor_b, idx, pcs.strides_b.row);
                }
            }
        }

        [ForceUnroll] for (uint s = 0; s < 8; ++s)
        {
            [ForceUnroll] for (uint mi = 0; mi < warp_frags_m; ++mi)
            {
                [ForceUnroll] for (uint nj = 0; nj < warp_frags_n; ++nj)
                {
                    uint flat_idx = mi * warp_frags_n + nj;
                    acc[flat_idx] = linalg::coopMatMulAdd<{{ d1 }}, false>(matA8[s][mi], matB8[s][nj], acc[flat_idx]);
                }
            }
        }
    }

    for (; k + 4 * block_size_acc <= k_main_end; k += 4 * block_size_acc)
    {
        linalg::CoopMat<{{ d1 }}, MemoryScope.Subgroup, block_size, block_size_acc, linalg::CoopMatMatrixUse.MatrixA> matA4[4][warp_frags_m];
        [ForceUnroll] for (uint s = 0; s < 4; ++s)
        {
            [ForceUnroll] for (uint mi = 0; mi < warp_frags_m; ++mi)
            {
                uint idx = batch_offset_a + a_rows[mi] * pcs.strides_a.row + (k + s * block_size_acc) * pcs.strides_a.col;
                if (A_TRANSPOSED == 1) {
                    matA4[s][mi] = matA4[s][mi].Load<linalg::CoopMatMatrixLayout.ColumnMajor>(tensor_a, idx, pcs.strides_a.col);
                } else {
                    matA4[s][mi] = matA4[s][mi].Load<linalg::CoopMatMatrixLayout.RowMajor>(tensor_a, idx, pcs.strides_a.row);
                }
            }
        }

        linalg::CoopMat<{{ d1 }}, MemoryScope.Subgroup, block_size_acc, block_size, linalg::CoopMatMatrixUse.MatrixB> matB4[4][warp_frags_n];
        [ForceUnroll] for (uint s = 0; s < 4; ++s)
        {
            [ForceUnroll] for (uint nj = 0; nj < warp_frags_n; ++nj)
            {
                uint idx = batch_offset_b + (k + s * block_size_acc) * pcs.strides_b.row + b_cols[nj] * pcs.strides_b.col;
                if (B_TRANSPOSED == 1) {
                    matB4[s][nj] = matB4[s][nj].Load<linalg::CoopMatMatrixLayout.ColumnMajor>(tensor_b, idx, pcs.strides_b.col);
                } else {
                    matB4[s][nj] = matB4[s][nj].Load<linalg::CoopMatMatrixLayout.RowMajor>(tensor_b, idx, pcs.strides_b.row);
                }
            }
        }

        [ForceUnroll] for (uint s = 0; s < 4; ++s)
        {
            [ForceUnroll] for (uint mi = 0; mi < warp_frags_m; ++mi)
            {
                [ForceUnroll] for (uint nj = 0; nj < warp_frags_n; ++nj)
                {
                    uint flat_idx = mi * warp_frags_n + nj;
                    acc[flat_idx] = linalg::coopMatMulAdd<{{ d1 }}, false>(matA4[s][mi], matB4[s][nj], acc[flat_idx]);
                }
            }
        }
    }

    for (; k + 2 * block_size_acc <= k_main_end; k += 2 * block_size_acc)
    {
        linalg::CoopMat<{{ d1 }}, MemoryScope.Subgroup, block_size, block_size_acc, linalg::CoopMatMatrixUse.MatrixA> matA0[warp_frags_m];
        linalg::CoopMat<{{ d1 }}, MemoryScope.Subgroup, block_size, block_size_acc, linalg::CoopMatMatrixUse.MatrixA> matA1[warp_frags_m];
        [ForceUnroll] for (uint mi = 0; mi < warp_frags_m; ++mi)
        {
            uint idx0 = batch_offset_a + a_rows[mi] * pcs.strides_a.row + k * pcs.strides_a.col;
            uint idx1 = batch_offset_a + a_rows[mi] * pcs.strides_a.row + (k + block_size_acc) * pcs.strides_a.col;
            if (A_TRANSPOSED == 1) {
                matA0[mi] = matA0[mi].Load<linalg::CoopMatMatrixLayout.ColumnMajor>(tensor_a, idx0, pcs.strides_a.col);
                matA1[mi] = matA1[mi].Load<linalg::CoopMatMatrixLayout.ColumnMajor>(tensor_a, idx1, pcs.strides_a.col);
            } else {
                matA0[mi] = matA0[mi].Load<linalg::CoopMatMatrixLayout.RowMajor>(tensor_a, idx0, pcs.strides_a.row);
                matA1[mi] = matA1[mi].Load<linalg::CoopMatMatrixLayout.RowMajor>(tensor_a, idx1, pcs.strides_a.row);
            }
        }

        linalg::CoopMat<{{ d1 }}, MemoryScope.Subgroup, block_size_acc, block_size, linalg::CoopMatMatrixUse.MatrixB> matB0[warp_frags_n];
        linalg::CoopMat<{{ d1 }}, MemoryScope.Subgroup, block_size_acc, block_size, linalg::CoopMatMatrixUse.MatrixB> matB1[warp_frags_n];
        [ForceUnroll] for (uint nj = 0; nj < warp_frags_n; ++nj)
        {
            uint idx0 = batch_offset_b + k * pcs.strides_b.row + b_cols[nj] * pcs.strides_b.col;
            uint idx1 = batch_offset_b + (k + block_size_acc) * pcs.strides_b.row + b_cols[nj] * pcs.strides_b.col;
            if (B_TRANSPOSED == 1) {
                matB0[nj] = matB0[nj].Load<linalg::CoopMatMatrixLayout.ColumnMajor>(tensor_b, idx0, pcs.strides_b.col);
                matB1[nj] = matB1[nj].Load<linalg::CoopMatMatrixLayout.ColumnMajor>(tensor_b, idx1, pcs.strides_b.col);
            } else {
                matB0[nj] = matB0[nj].Load<linalg::CoopMatMatrixLayout.RowMajor>(tensor_b, idx0, pcs.strides_b.row);
                matB1[nj] = matB1[nj].Load<linalg::CoopMatMatrixLayout.RowMajor>(tensor_b, idx1, pcs.strides_b.row);
            }
        }

        [ForceUnroll] for (uint mi = 0; mi < warp_frags_m; ++mi)
        {
            [ForceUnroll] for (uint nj = 0; nj < warp_frags_n; ++nj)
            {
                uint flat_idx = mi * warp_frags_n + nj;
                acc[flat_idx] = linalg::coopMatMulAdd<{{ d1 }}, false>(matA0[mi], matB0[nj], acc[flat_idx]);
            }
        }
        [ForceUnroll] for (uint mi = 0; mi < warp_frags_m; ++mi)
        {
            [ForceUnroll] for (uint nj = 0; nj < warp_frags_n; ++nj)
            {
                uint flat_idx = mi * warp_frags_n + nj;
                acc[flat_idx] = linalg::coopMatMulAdd<{{ d1 }}, false>(matA1[mi], matB1[nj], acc[flat_idx]);
            }
        }
    }

    for (; k + block_size_acc <= k_main_end; k += block_size_acc)
    {
        linalg::CoopMat<{{ d1 }}, MemoryScope.Subgroup, block_size, block_size_acc, linalg::CoopMatMatrixUse.MatrixA> matA[warp_frags_m];
        [ForceUnroll] for (uint mi = 0; mi < warp_frags_m; ++mi)
        {
            uint global_idx = batch_offset_a + a_rows[mi] * pcs.strides_a.row + k * pcs.strides_a.col;
            if (A_TRANSPOSED == 1) {
                matA[mi] = matA[mi].Load<linalg::CoopMatMatrixLayout.ColumnMajor>(tensor_a, global_idx, pcs.strides_a.col);
            } else {
                matA[mi] = matA[mi].Load<linalg::CoopMatMatrixLayout.RowMajor>(tensor_a, global_idx, pcs.strides_a.row);
            }
        }

        linalg::CoopMat<{{ d1 }}, MemoryScope.Subgroup, block_size_acc, block_size, linalg::CoopMatMatrixUse.MatrixB> matB[warp_frags_n];
        [ForceUnroll] for (uint nj = 0; nj < warp_frags_n; ++nj)
        {
            uint global_idx = batch_offset_b + k * pcs.strides_b.row + b_cols[nj] * pcs.strides_b.col;
            if (B_TRANSPOSED == 1) {
                matB[nj] = matB[nj].Load<linalg::CoopMatMatrixLayout.ColumnMajor>(tensor_b, global_idx, pcs.strides_b.col);
            } else {
                matB[nj] = matB[nj].Load<linalg::CoopMatMatrixLayout.RowMajor>(tensor_b, global_idx, pcs.strides_b.row);
            }
        }

        [ForceUnroll] for (uint mi = 0; mi < warp_frags_m; ++mi)
        {
            [ForceUnroll] for (uint nj = 0; nj < warp_frags_n; ++nj)
            {
                uint flat_idx = mi * warp_frags_n + nj;
                acc[flat_idx] = linalg::coopMatMulAdd<{{ d1 }}, false>(matA[mi], matB[nj], acc[flat_idx]);
            }
        }
    }

    if (k < pcs.k_dim)
    {
        for (uint i = ti; i < (WARPS_M * warp_frags_m * block_size) * BK; i += total_threads)
        {
            uint r = i / BK;
            uint c = i % BK;
            uint a_row = (M_ALIGNED == 1 ? (tile_m + r) : min(tile_m + r, pcs.m_dim - 1));
            {{ d1 }} val = ({{ d1 }})0;
            if ((k + c) < pcs.k_dim)
            {
                uint global_idx = batch_offset_a + a_row * pcs.strides_a.row + (k + c) * pcs.strides_a.col;
                val = tensor_a[global_idx];
            }
            smemTailA[r * BK + c] = val;
        }

        for (uint i = ti; i < BK * (WARPS_N * warp_frags_n * block_size); i += total_threads)
        {
            uint r = i / (WARPS_N * warp_frags_n * block_size);
            uint c = i % (WARPS_N * warp_frags_n * block_size);
            uint b_col = (N_ALIGNED == 1 ? (tile_n + c) : min(tile_n + c, pcs.n_dim - 1));
            {{ d1 }} val = ({{ d1 }})0;
            if ((k + r) < pcs.k_dim)
            {
                uint global_idx = batch_offset_b + (k + r) * pcs.strides_b.row + b_col * pcs.strides_b.col;
                val = tensor_b[global_idx];
            }
            smemTailB[r * (WARPS_N * warp_frags_n * block_size) + c] = val;
        }

        GroupMemoryBarrierWithGroupSync();

        for (uint step = 0; step < BK; step += block_size_acc)
        {
            linalg::CoopMat<{{ d1 }}, MemoryScope.Subgroup, block_size, block_size_acc, linalg::CoopMatMatrixUse.MatrixA> matA[warp_frags_m];
            [ForceUnroll] for (uint mi = 0; mi < warp_frags_m; ++mi)
            {
                uint off = (warp_row_base + mi * block_size) * BK + step;
                matA[mi] = matA[mi].Load<linalg::CoopMatMatrixLayout.RowMajor>(smemTailA, off, BK);
            }

            linalg::CoopMat<{{ d1 }}, MemoryScope.Subgroup, block_size_acc, block_size, linalg::CoopMatMatrixUse.MatrixB> matB[warp_frags_n];
            [ForceUnroll] for (uint nj = 0; nj < warp_frags_n; ++nj)
            {
                uint off = step * (WARPS_N * warp_frags_n * block_size) + (warp_col_base + nj * block_size);
                matB[nj] = matB[nj].Load<linalg::CoopMatMatrixLayout.RowMajor>(smemTailB, off, (WARPS_N * warp_frags_n * block_size));
            }

            [ForceUnroll] for (uint mi = 0; mi < warp_frags_m; ++mi)
            {
                [ForceUnroll] for (uint nj = 0; nj < warp_frags_n; ++nj)
                {
                    uint flat_idx = mi * warp_frags_n + nj;
                    acc[flat_idx] = linalg::coopMatMulAdd<{{ d1 }}, false>(matA[mi], matB[nj], acc[flat_idx]);
                }
            }
        }
    }

    [ForceUnroll] for (uint mi = 0; mi < warp_frags_m; ++mi) 
    {
        [ForceUnroll] for (uint nj = 0; nj < warp_frags_n; ++nj) 
        {
            uint flat_idx = mi * warp_frags_n + nj;            
            uint row = tile_m + warp_row_base + mi * block_size;
            uint col = tile_n + warp_col_base + nj * block_size;

            if (HAS_ALPHA == 1) 
            {
                acc[flat_idx] = acc[flat_idx] * pcs.alpha;
            }

            if (HAS_BETA == 1) 
            {
                uint c_idx = batch_offset_out + (row * pcs.strides_out.row) + (col * pcs.strides_out.col);
                linalg::CoopMat<{{ d1 }}, MemoryScope.Subgroup, block_size, block_size, linalg::CoopMatMatrixUse.MatrixAccumulator> matC;
                if (OUT_TRANSPOSED == 1) {
                    matC = matC.Load<linalg::CoopMatMatrixLayout.ColumnMajor>(tensor_out, c_idx, pcs.strides_out.col);
                } else {
                    matC = matC.Load<linalg::CoopMatMatrixLayout.RowMajor>(tensor_out, c_idx, pcs.strides_out.row);
                }
                acc[flat_idx] = acc[flat_idx] + (matC * pcs.beta);
            }

            if (HAS_BIAS == 1)
            {
                uint bias_row = min(row, pcs.m_dim - 1);
                uint bias_col = min(col, pcs.n_dim - 1);
                uint bias_idx = (wg.z * pcs.strides_bias.batch) + (bias_row * pcs.strides_bias.row) + (bias_col * pcs.strides_bias.col);
                linalg::CoopMat<{{ d1 }}, MemoryScope.Subgroup, block_size, block_size, linalg::CoopMatMatrixUse.MatrixAccumulator> matBias;
                if (BIAS_TRANSPOSED == 1) {
                    matBias = matBias.Load<linalg::CoopMatMatrixLayout.ColumnMajor>(tensor_bias, bias_idx, pcs.strides_bias.col);
                } else {
                    matBias = matBias.Load<linalg::CoopMatMatrixLayout.RowMajor>(tensor_bias, bias_idx, pcs.strides_bias.row);
                }
                acc[flat_idx] = acc[flat_idx] + (matBias * pcs.beta);
            }
        }
    }

    {% else %}

    uint smem_a_rows = WARPS_M * warp_frags_m * block_size;
    uint smem_b_cols = WARPS_N * warp_frags_n * block_size;

    uint smem_a_size = smem_a_rows * (BK + PAD);
    uint smem_b_size = BK * (smem_b_cols + PAD);
    
    uint total_vec_threads_a = (smem_a_rows * BK) / {{ v1 }};
    uint total_vec_threads_b = (BK * smem_b_cols) / {{ v1 }};
    
    uint stage = 0;

    if (pcs.k_dim > 0) 
    {
        uint smem_a_offset = 0;
        uint smem_b_offset = 0;

        if (A_TRANSPOSED == 1)
        {
            for (uint i = ti; i < total_vec_threads_a; i += total_threads)
            {
                [unroll] for (uint v = 0; v < {{ v1 }}; ++v)
                {
                    uint flat_smem_idx = i * {{ v1 }} + v;
                    uint r = flat_smem_idx % smem_a_rows;
                    uint c = flat_smem_idx / smem_a_rows;
                    uint a_row = (M_ALIGNED == 1 ? (tile_m + r) : min(tile_m + r, pcs.m_dim - 1));
                    {{ d1 }} val = ({{ d1 }})0;
                    if ((0 + c) < pcs.k_dim)
                    {
                        uint global_idx = batch_offset_a + a_row * pcs.strides_a.row + (0 + c) * pcs.strides_a.col; // K = 0
                        val = tensor_a[global_idx];
                    }
                    smemA[smem_a_offset + r * (BK + PAD) + c] = val;
                }
            }
        }
        else
        {
            for (uint i = ti; i < total_vec_threads_a; i += total_threads)
            {
                uint flat_smem_idx = i * {{ v1 }};
                uint r = flat_smem_idx / BK;
                uint c = flat_smem_idx % BK;
                uint a_row = (M_ALIGNED == 1 ? (tile_m + r) : min(tile_m + r, pcs.m_dim - 1));
                uint padded_smem_idx = r * (BK + PAD) + c;

                if (A_VEC_ALIGNED == 1 && (0 + c + {{ v1 }}) <= pcs.k_dim)
                {
                    uint global_idx = batch_offset_a + a_row * pcs.strides_a.row + (0 + c); // K = 0
                    vector<{{ d1 }}, {{ v1 }}> vec_val = tensor_a_vec[global_idx / {{ v1 }}];
                    [unroll] for (uint v = 0; v < {{ v1 }}; ++v) {
                        smemA[smem_a_offset + padded_smem_idx + v] = vec_val[v];
                    }
                }
                else
                {
                    [unroll] for (uint v = 0; v < {{ v1 }}; ++v)
                    {
                        uint k_idx = 0 + c + v;
                        {{ d1 }} val = ({{ d1 }})0;
                        if (k_idx < pcs.k_dim)
                        {
                            uint global_idx = batch_offset_a + a_row * pcs.strides_a.row + k_idx;
                            val = tensor_a[global_idx];
                        }
                        smemA[smem_a_offset + padded_smem_idx + v] = val;
                    }
                }
            }
        }

        if (B_TRANSPOSED == 1)
        {
            for (uint i = ti; i < total_vec_threads_b; i += total_threads)
            {
                [unroll] for (uint v = 0; v < {{ v1 }}; ++v)
                {
                    uint flat_smem_idx = i * {{ v1 }} + v;
                    uint r = flat_smem_idx % BK;
                    uint c = flat_smem_idx / BK;
                    uint b_col = (N_ALIGNED == 1 ? (tile_n + c) : min(tile_n + c, pcs.n_dim - 1));
                    {{ d1 }} val = ({{ d1 }})0;
                    if ((0 + r) < pcs.k_dim)
                    {
                        uint global_idx = batch_offset_b + (0 + r) * pcs.strides_b.row + b_col * pcs.strides_b.col; // K = 0
                        val = tensor_b[global_idx];
                    }
                    smemB[smem_b_offset + r * ((WARPS_N * warp_frags_n * block_size) + PAD) + c] = val;
                }
            }
        }
        else
        {
            for (uint i = ti; i < total_vec_threads_b; i += total_threads)
            {
                uint flat_smem_idx = i * {{ v1 }};
                uint r = flat_smem_idx / (WARPS_N * warp_frags_n * block_size);
                uint c = flat_smem_idx % (WARPS_N * warp_frags_n * block_size);
                uint padded_smem_idx = r * ((WARPS_N * warp_frags_n * block_size) + PAD) + c;

                if ((0 + r) >= pcs.k_dim)
                {
                    [unroll] for (uint v = 0; v < {{ v1 }}; ++v) {
                        smemB[smem_b_offset + padded_smem_idx + v] = ({{ d1 }})0;
                    }
                }
                else if (B_VEC_ALIGNED == 1 && (tile_n + c + {{ v1 }}) <= pcs.n_dim)
                {
                    uint global_idx = batch_offset_b + (0 + r) * pcs.strides_b.row + (tile_n + c) * pcs.strides_b.col; // K = 0
                    vector<{{ d1 }}, {{ v1 }}> vec_val = tensor_b_vec[global_idx / {{ v1 }}];
                    [unroll] for (uint v = 0; v < {{ v1 }}; ++v) {
                        smemB[smem_b_offset + padded_smem_idx + v] = vec_val[v];
                    }
                }
                else
                {
                    [unroll] for (uint v = 0; v < {{ v1 }}; ++v)
                    {
                        uint b_col = (N_ALIGNED == 1 ? (tile_n + c + v) : min(tile_n + c + v, pcs.n_dim - 1));
                        uint global_idx = batch_offset_b + (0 + r) * pcs.strides_b.row + b_col * pcs.strides_b.col; // K = 0
                        smemB[smem_b_offset + padded_smem_idx + v] = tensor_b[global_idx];
                    }
                }
            }
        }
        GroupMemoryBarrierWithGroupSync();
    }

    for (uint k = 0; k < pcs.k_dim; k += BK)
    {
        uint next_k = k + BK;
        uint next_stage = stage ^ 1; 

        if (next_k < pcs.k_dim) 
        {
            uint smem_a_offset = next_stage * smem_a_size;
            uint smem_b_offset = next_stage * smem_b_size;

            if (A_TRANSPOSED == 1)
            {
                for (uint i = ti; i < total_vec_threads_a; i += total_threads)
                {
                    [unroll] for (uint v = 0; v < {{ v1 }}; ++v)
                    {
                        uint flat_smem_idx = i * {{ v1 }} + v;
                        uint r = flat_smem_idx % smem_a_rows;
                        uint c = flat_smem_idx / smem_a_rows;
                        uint a_row = (M_ALIGNED == 1 ? (tile_m + r) : min(tile_m + r, pcs.m_dim - 1));
                        {{ d1 }} val = ({{ d1 }})0;
                        if ((next_k + c) < pcs.k_dim)
                        {
                            uint global_idx = batch_offset_a + a_row * pcs.strides_a.row + (next_k + c) * pcs.strides_a.col;
                            val = tensor_a[global_idx];
                        }
                        smemA[smem_a_offset + r * (BK + PAD) + c] = val;
                    }
                }
            }
            else
            {
                for (uint i = ti; i < total_vec_threads_a; i += total_threads)
                {
                    uint flat_smem_idx = i * {{ v1 }};
                    uint r = flat_smem_idx / BK;
                    uint c = flat_smem_idx % BK;
                    uint a_row = (M_ALIGNED == 1 ? (tile_m + r) : min(tile_m + r, pcs.m_dim - 1));
                    uint padded_smem_idx = r * (BK + PAD) + c;

                    if (A_VEC_ALIGNED == 1 && (next_k + c + {{ v1 }}) <= pcs.k_dim)
                    {
                        uint global_idx = batch_offset_a + a_row * pcs.strides_a.row + (next_k + c);
                        vector<{{ d1 }}, {{ v1 }}> vec_val = tensor_a_vec[global_idx / {{ v1 }}];
                        [unroll] for (uint v = 0; v < {{ v1 }}; ++v)
                        {
                            smemA[smem_a_offset + padded_smem_idx + v] = vec_val[v];
                        }
                    }
                    else
                    {
                        [unroll] for (uint v = 0; v < {{ v1 }}; ++v)
                        {
                            uint k_idx = next_k + c + v;
                            {{ d1 }} val = ({{ d1 }})0;
                            if (k_idx < pcs.k_dim)
                            {
                                uint global_idx = batch_offset_a + a_row * pcs.strides_a.row + k_idx;
                                val = tensor_a[global_idx];
                            }
                            smemA[smem_a_offset + padded_smem_idx + v] = val;
                        }
                    }
                }
            }

            if (B_TRANSPOSED == 1)
            {
                for (uint i = ti; i < total_vec_threads_b; i += total_threads)
                {
                    [unroll] for (uint v = 0; v < {{ v1 }}; ++v)
                    {
                        uint flat_smem_idx = i * {{ v1 }} + v;
                        uint r = flat_smem_idx % BK;
                        uint c = flat_smem_idx / BK;
                        uint b_col = (N_ALIGNED == 1 ? (tile_n + c) : min(tile_n + c, pcs.n_dim - 1));
                        {{ d1 }} val = ({{ d1 }})0;
                        if ((next_k + r) < pcs.k_dim)
                        {
                            uint global_idx = batch_offset_b + (next_k + r) * pcs.strides_b.row + b_col * pcs.strides_b.col;
                            val = tensor_b[global_idx];
                        }
                        smemB[smem_b_offset + r * ((WARPS_N * warp_frags_n * block_size) + PAD) + c] = val;
                    }
                }
            }
            else
            {
                for (uint i = ti; i < total_vec_threads_b; i += total_threads)
                {
                    uint flat_smem_idx = i * {{ v1 }};
                    uint r = flat_smem_idx / (WARPS_N * warp_frags_n * block_size);
                    uint c = flat_smem_idx % (WARPS_N * warp_frags_n * block_size);
                    uint padded_smem_idx = r * ((WARPS_N * warp_frags_n * block_size) + PAD) + c;

                    if ((next_k + r) >= pcs.k_dim)
                    {
                        [unroll] for (uint v = 0; v < {{ v1 }}; ++v)
                        {
                            smemB[smem_b_offset + padded_smem_idx + v] = ({{ d1 }})0;
                        }
                    }
                    else if (B_VEC_ALIGNED == 1 && (tile_n + c + {{ v1 }}) <= pcs.n_dim)
                    {
                        uint global_idx = batch_offset_b + (next_k + r) * pcs.strides_b.row + (tile_n + c) * pcs.strides_b.col;
                        vector<{{ d1 }}, {{ v1 }}> vec_val = tensor_b_vec[global_idx / {{ v1 }}];
                        [unroll] for (uint v = 0; v < {{ v1 }}; ++v)
                        {
                            smemB[smem_b_offset + padded_smem_idx + v] = vec_val[v];
                        }
                    }
                    else
                    {
                        [unroll] for (uint v = 0; v < {{ v1 }}; ++v)
                        {
                            uint b_col = (N_ALIGNED == 1 ? (tile_n + c + v) : min(tile_n + c + v, pcs.n_dim - 1));
                            uint global_idx = batch_offset_b + (next_k + r) * pcs.strides_b.row + b_col * pcs.strides_b.col;
                            smemB[smem_b_offset + padded_smem_idx + v] = tensor_b[global_idx];
                        }
                    }
                }
            }
        }

        uint current_smem_a_offset = stage * smem_a_size;
        uint current_smem_b_offset = stage * smem_b_size;

        for (uint step = 0; step < BK; step += block_size_acc) 
        {
            linalg::CoopMat<{{ d1 }}, MemoryScope.Subgroup, block_size, block_size_acc, linalg::CoopMatMatrixUse.MatrixA> matA[warp_frags_m];
            [ForceUnroll] for (uint mi = 0; mi < warp_frags_m; ++mi) 
            {
                uint off = current_smem_a_offset + (warp_row_base + mi * block_size) * (BK + PAD) + step;
                matA[mi] = matA[mi].Load<linalg::CoopMatMatrixLayout.RowMajor>(smemA, off, BK + PAD);
            }

            linalg::CoopMat<{{ d1 }}, MemoryScope.Subgroup, block_size_acc, block_size, linalg::CoopMatMatrixUse.MatrixB> matB[warp_frags_n];
            [ForceUnroll] for (uint nj = 0; nj < warp_frags_n; ++nj) 
            {
                uint off = current_smem_b_offset + step * ((WARPS_N * warp_frags_n * block_size) + PAD) + (warp_col_base + nj * block_size);
                matB[nj] = matB[nj].Load<linalg::CoopMatMatrixLayout.RowMajor>(smemB, off, (WARPS_N * warp_frags_n * block_size) + PAD);
            }

            [ForceUnroll] for (uint mi = 0; mi < warp_frags_m; ++mi) 
            {
                [ForceUnroll] for (uint nj = 0; nj < warp_frags_n; ++nj) 
                {
                    uint flat_idx = mi * warp_frags_n + nj;
                    acc[flat_idx] = linalg::coopMatMulAdd<{{ d1 }}, false>(matA[mi], matB[nj], acc[flat_idx]);
                }
            }
        }

        GroupMemoryBarrierWithGroupSync();
        stage = next_stage;
    }

    [ForceUnroll] for (uint mi = 0; mi < warp_frags_m; ++mi) 
    {
        [ForceUnroll] for (uint nj = 0; nj < warp_frags_n; ++nj) 
        {
            uint flat_idx = mi * warp_frags_n + nj;            
            uint row = tile_m + warp_row_base + mi * block_size;
            uint col = tile_n + warp_col_base + nj * block_size;

            if (HAS_ALPHA == 1) 
            {
                acc[flat_idx] = acc[flat_idx] * pcs.alpha;
            }

            if (HAS_BETA == 1) 
            {
                uint c_idx = batch_offset_out + (row * pcs.strides_out.row) + (col * pcs.strides_out.col);
                linalg::CoopMat<{{ d1 }}, MemoryScope.Subgroup, block_size, block_size, linalg::CoopMatMatrixUse.MatrixAccumulator> matC;
                if (OUT_TRANSPOSED == 1) {
                    matC = matC.Load<linalg::CoopMatMatrixLayout.ColumnMajor>(tensor_out, c_idx, pcs.strides_out.col);
                } else {
                    matC = matC.Load<linalg::CoopMatMatrixLayout.RowMajor>(tensor_out, c_idx, pcs.strides_out.row);
                }
                acc[flat_idx] = acc[flat_idx] + (matC * pcs.beta);
            }

            if (HAS_BIAS == 1)
            {
                // bias is not padded to the tile size either - clamp separately from the (unclamped) row/col used for `out`.
                uint bias_row = min(row, pcs.m_dim - 1);
                uint bias_col = min(col, pcs.n_dim - 1);
                uint bias_idx = (wg.z * pcs.strides_bias.batch) + (bias_row * pcs.strides_bias.row) + (bias_col * pcs.strides_bias.col);
                linalg::CoopMat<{{ d1 }}, MemoryScope.Subgroup, block_size, block_size, linalg::CoopMatMatrixUse.MatrixAccumulator> matBias;
                if (BIAS_TRANSPOSED == 1) {
                    matBias = matBias.Load<linalg::CoopMatMatrixLayout.ColumnMajor>(tensor_bias, bias_idx, pcs.strides_bias.col);
                } else {
                    matBias = matBias.Load<linalg::CoopMatMatrixLayout.RowMajor>(tensor_bias, bias_idx, pcs.strides_bias.row);
                }
                acc[flat_idx] = acc[flat_idx] + (matBias * pcs.beta);
            }
        }
    }

    {% endif %}

    [ForceUnroll] for (uint mi = 0; mi < warp_frags_m; ++mi) 
    {
        [ForceUnroll] for (uint nj = 0; nj < warp_frags_n; ++nj) 
        {
            uint row = tile_m + warp_row_base + mi * block_size;
            uint col = tile_n + warp_col_base + nj * block_size;

            // no need to write out-of-bounds values
            if (M_ALIGNED == 0 && row >= pcs.m_dim) continue;
            if (N_ALIGNED == 0 && col >= pcs.n_dim) continue;

            uint out_idx = batch_offset_out + row * pcs.strides_out.row + col * pcs.strides_out.col;
            uint flat_idx = mi * warp_frags_n + nj;
            if (OUT_TRANSPOSED == 1) {
                acc[flat_idx].Store<linalg::CoopMatMatrixLayout.ColumnMajor>(tensor_out, out_idx, pcs.strides_out.col);
            } else {
                acc[flat_idx].Store<linalg::CoopMatMatrixLayout.RowMajor>(tensor_out, out_idx, pcs.strides_out.row);
            }
        }
    }
}


[shader("compute")]
[numthreads(WORKGROUP_SIZE, 1, 1)]
void main(
    uint3 wg: SV_GroupID,
    uint  ti: SV_GroupIndex
)
{
    {{ d1 }}* tensor_a = ({{ d1 }}*)pcs.tensor_a;
    {{ d1 }}* tensor_b = ({{ d1 }}*)pcs.tensor_b;
    {{ d1 }}* tensor_out = ({{ d1 }}*)pcs.tensor_out;
    {{ d1 }}* tensor_bias = ({{ d1 }}*)pcs.tensor_bias;

    vector<{{ d1 }}, {{ v1 }}>* tensor_a_vec = (vector<{{ d1 }}, {{ v1 }}>*)pcs.tensor_a;
    vector<{{ d1 }}, {{ v1 }}>* tensor_b_vec = (vector<{{ d1 }}, {{ v1 }}>*)pcs.tensor_b;
    vector<{{ d1 }}, {{ v1 }}>* tensor_out_vec = (vector<{{ d1 }}, {{ v1 }}>*)pcs.tensor_out;
    vector<{{ d1 }}, {{ v1 }}>* tensor_bias_vec = (vector<{{ d1 }}, {{ v1 }}>*)pcs.tensor_bias;

    {% for warp_frags_m in [2, 4] %}
    {% for warp_frags_n in [2, 4] %}

    if (
        WARP_FRAGS_M == {{ warp_frags_m }} && WARP_FRAGS_N == {{ warp_frags_n }}
    ) 
    {
        matmulKernel<
            {{ BLOCK_SIZE }}, {{ BLOCK_SIZE }}, {{ warp_frags_m }}, {{ warp_frags_n }}
        >(
            wg, ti, 
            tensor_a, tensor_b, tensor_out, tensor_bias,
            tensor_a_vec, tensor_b_vec, tensor_out_vec, tensor_bias_vec
        );
    }

    {% endfor %}
    {% endfor %}
}