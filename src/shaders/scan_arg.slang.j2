{% include "helpers/int_divider.slang.j2" %}
{% include "helpers/vulkan_arithmetic.slang.j2" %}

[[vk::constant_id(0)]] const uint OP_TYPE = 0;
[[vk::constant_id(1)]] const uint NDIM = 0;
[[vk::constant_id(2)]] const uint WG_x = 0;

struct Metadata
{
    uint64_t sizes;
    uint64_t strides_in;
    uint64_t strides_out;
};

struct PushConstants
{
    uint64_t tensor_in;
    uint64_t tensor_val;
    uint64_t tensor_idx;
    uint64_t metadata;
    uint64_t num_lines;
    uint scan_size;
    uint scan_stride_in;
    uint scan_stride_out;
};

[[vk::push_constant]] ConstantBuffer<PushConstants> pcs;

struct ScanArgPair
{
    {{ d1 }} val;
    uint idx;
}

ScanArgPair combinePair(ScanArgPair a, ScanArgPair b)
{
    {% if 'float' in d1 %}
    if (isnan(a.val)) return a;
    if (isnan(b.val)) return b;
    {% endif %}
    bool take_b = (OP_TYPE == 0) ? (b.val >= a.val) : (b.val <= a.val);
    return take_b ? b : a;
}

groupshared {{ d1 }} smem_val[WG_x];
groupshared uint smem_idx[WG_x];

void scanArgKernel(
    uint line,
    uint lane,
    uint64_t address_in,
    uint64_t address_val,
    uint64_t address_idx,
    uint64_t address_metadata,
    uint64_t num_lines,
    uint scan_size,
    uint scan_stride_in,
    uint scan_stride_out
)
{
    if (line >= num_lines || scan_size == 0) return;

    {{ d1 }}* tensor_in = ({{ d1 }}*)address_in;
    {{ d1 }}* tensor_val = ({{ d1 }}*)address_val;
    int64_t* tensor_idx = (int64_t*)address_idx;

    Metadata md = *(Metadata*)address_metadata;
    uint* strides_in = (uint*)md.strides_in;
    uint* strides_out = (uint*)md.strides_out;

    uint base_in = 0;
    uint base_out = 0;
    uint linear_idx = line;

    for (uint i = 0; i < NDIM; i++)
    {
        uint next_linear_idx = fast_div(md.sizes, linear_idx, i, NDIM);
        uint divisor = get_divisor(md.sizes, i);
        uint coord = linear_idx - (next_linear_idx * divisor);
        linear_idx = next_linear_idx;
        base_in += coord * strides_in[i];
        base_out += coord * strides_out[i];
    }

    ScanArgPair carry;
    carry.val = (OP_TYPE == 0) ? {{ d1 }}.ext_lowest() : {{ d1 }}.ext_highest();
    carry.idx = 0;

    for (uint chunk_start = 0; chunk_start < scan_size; chunk_start += WG_x)
    {
        // make sure every thread is done reading last chunk's smem before we overwrite it
        GroupMemoryBarrierWithGroupSync();

        uint j = chunk_start + lane;
        ScanArgPair value;
        if (j < scan_size) { value.val = tensor_in[base_in + j * scan_stride_in]; value.idx = j; }
        else { value.val = carry.val; value.idx = 0; }
        smem_val[lane] = value.val;
        smem_idx[lane] = value.idx;
        GroupMemoryBarrierWithGroupSync();

        [loop] for (uint step = 1; step < WG_x; step *= 2)
        {
            ScanArgPair v;
            v.val = smem_val[lane]; v.idx = smem_idx[lane];
            if (lane >= step)
            {
                ScanArgPair prev;
                prev.val = smem_val[lane - step]; prev.idx = smem_idx[lane - step];
                v = combinePair(prev, v);
            }
            GroupMemoryBarrierWithGroupSync(); // every lane has read before any lane writes
            smem_val[lane] = v.val; smem_idx[lane] = v.idx;
            GroupMemoryBarrierWithGroupSync(); // every lane sees this step's result before the next
        }

        if (j < scan_size)
        {
            ScanArgPair local;
            local.val = smem_val[lane]; local.idx = smem_idx[lane];
            ScanArgPair result = combinePair(carry, local);
            tensor_val[base_out + j * scan_stride_out] = result.val;
            tensor_idx[base_out + j * scan_stride_out] = int64_t(result.idx);
        }

        uint last_lane = min(WG_x, scan_size - chunk_start) - 1;
        ScanArgPair last;
        last.val = smem_val[last_lane]; last.idx = smem_idx[last_lane];
        carry = combinePair(carry, last);
    }
}

[shader("compute")]
[numthreads(WG_x, 1, 1)]
void main(uint3 group_id: SV_GroupID, uint3 group_thread_id: SV_GroupThreadID)
{
    scanArgKernel(
        group_id.x, group_thread_id.x,
        pcs.tensor_in, pcs.tensor_val, pcs.tensor_idx, pcs.metadata,
        pcs.num_lines, pcs.scan_size, pcs.scan_stride_in, pcs.scan_stride_out
    );
}
