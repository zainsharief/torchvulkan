struct PushConstants
{
    IntDivider sizes;
    uint4 strides_in;
    uint4 strides_out;
    uint64_t numel;
};

[[vk::push_constant]] ConstantBuffer<PushConstants> pcs;

interface IUnaryOp<T>
{
    static T eval(T a);
}

