{% include "helpers/int_divider.slang.j2" %}
{% include "helpers/vulkan_arithmetic.slang.j2" %}

[[vk::constant_id(0)]] const uint OP_TYPE = 0;
[[vk::constant_id(1)]] const uint IS_CONTIG = 0;
[[vk::constant_id(2)]] const uint NDIM = 0;
[[vk::constant_id(3)]] const uint WG_x = 0;

struct PushConstants
{
    IntDivider sizes;
    uint4 strides_in;
    uint4 strides_out;
    uint64_t numel;
};

[[vk::push_constant]] ConstantBuffer<PushConstants> pcs;

interface IUnaryOp<T>
{
    static T eval(T a);
}

struct ReluOp<T : IVulkanArithmetic> : IUnaryOp<T>
{
    static T eval(T a) { return T.ext_max(a, T.ext_zero()); }
}

struct ExpOp<T : IVulkanArithmetic> : IUnaryOp<T>
{
    static T eval(T a) { return T.ext_exp(a); }
}

struct LogOp<T : IVulkanArithmetic> : IUnaryOp<T>
{
    static T eval(T a) { return T.ext_log(a); }
}

struct SqrtOp<T : IVulkanArithmetic> : IUnaryOp<T>
{
    static T eval(T a) { return T.ext_sqrt(a); }
}

struct NegOp<T : IVulkanArithmetic> : IUnaryOp<T>
{
    static T eval(T a) { return T.ext_neg(a); }
}

struct ReciprocalOp<T : IVulkanArithmetic> : IUnaryOp<T>
{
    static T eval(T a) { return T.ext_reciprocal(a); }
}

void baseUnaryKernel<
    T,
    let VEC_SIZE : int,
    Op : IUnaryOp<vector<T, VEC_SIZE>>
>(
    uint3 gi: SV_DispatchThreadID,
    StructuredBuffer<vector<T, VEC_SIZE>> tensor_in,
    RWStructuredBuffer<vector<T, VEC_SIZE>> tensor_out
)
{
    uint idx = gi.x;
    if (idx * VEC_SIZE >= pcs.numel) return;

    vector<T, VEC_SIZE> res = Op.eval(tensor_in[idx]);

    uint remainder = pcs.numel - (idx * VEC_SIZE);
    if (remainder >= VEC_SIZE) { tensor_out[idx] = res; }
    else {
        vector<T, VEC_SIZE> temp = tensor_out[idx];
        for (uint i = 0; i < remainder; i++) { temp[i] = res[i]; }
        tensor_out[idx] = temp;
    }
}

void baseUnaryKernel<
    T,
    let ndim : int,
    Op : IUnaryOp<T>
>(
    uint3 gi: SV_DispatchThreadID,
    StructuredBuffer<T> tensor_in,
    RWStructuredBuffer<T> tensor_out
)
{
    uint idx = gi.x;
    if (idx >= pcs.numel) return;

    uint idx_in = 0;
    uint idx_out = 0;
    uint linear_idx = idx;

    [unroll]
    for (int i = 0; i < ndim; i++) {
        uint next_linear_idx = fast_div(linear_idx, pcs.sizes, i);
        uint coord = linear_idx - (next_linear_idx * pcs.sizes.divisor[i]);
        linear_idx = next_linear_idx;
        idx_in += coord * pcs.strides_in[i];
        idx_out += coord * pcs.strides_out[i];
    }

    tensor_out[idx_out] = Op.eval(tensor_in[idx_in]);
}

[[vk::binding(0, 0)]] StructuredBuffer<vector<{{ d1 }}, {{ v1 }}>> tensor_in_contig;
[[vk::binding(1, 0)]] RWStructuredBuffer<vector<{{ d1 }}, {{ v1 }}>> tensor_out_contig;

[[vk::binding(0, 0)]] StructuredBuffer<{{ d1 }}> tensor_in_noncontig;
[[vk::binding(1, 0)]] RWStructuredBuffer<{{ d1 }}> tensor_out_noncontig;

[shader("compute")]
[numthreads(WG_x, 1, 1)]
void main(uint3 gi: SV_DispatchThreadID) {

    {% for is_contig in [true, false] %}
    {% for op in OPERATIONS %}

    {% if is_contig %}

    if (IS_CONTIG != 0 && OP_TYPE == {{ op['name'] }}) baseUnaryKernel<{{ d1 }}, {{ v1 }}, {{ op['struct'] }}<vector<{{ d1 }}, {{ v1 }}>>>(
        gi, tensor_in_contig, tensor_out_contig
    );

    {% else %}

    {% for dim in range(MAX_DIMS+1) %}
    if (IS_CONTIG == 0 && OP_TYPE == {{ op['name'] }} && NDIM == {{ dim }}) baseUnaryKernel<{{ d1 }}, {{ dim }}, {{ op['struct'] }}<{{ d1 }}>>(
        gi, tensor_in_noncontig, tensor_out_noncontig
    );
    {% endfor %}

    {% endif %}

    {% endfor %}
    {% endfor %}
}
