void baseUnaryKernel<
    T,
    let VEC_SIZE : int,
    Op : IUnaryOp<T>
>(
    uint3 gi: SV_DispatchThreadID,
    StructuredBuffer<vector<T, VEC_SIZE>> tensor_in,
    RWStructuredBuffer<vector<T, VEC_SIZE>> tensor_out
)
{
    uint idx = gi.x;
    if (idx * VEC_SIZE >= pcs.numel) return;

    vector<T, VEC_SIZE> v = tensor_in[idx];
    vector<T, VEC_SIZE> res;
    [unroll] for (int k = 0; k < VEC_SIZE; k++) res[k] = Op.eval(v[k]);

    uint64_t remainder = pcs.numel - (idx * VEC_SIZE);
    if (remainder >= VEC_SIZE) { tensor_out[idx] = res; }
    else {
        vector<T, VEC_SIZE> temp = tensor_out[idx];
        for (uint i = 0; i < remainder; i++) { temp[i] = res[i]; }
        tensor_out[idx] = temp;
    }
}

void baseUnaryKernel<
    T,
    let ndim : int,
    Op : IUnaryOp<T>
>(
    uint3 gi: SV_DispatchThreadID,
    StructuredBuffer<T> tensor_in,
    RWStructuredBuffer<T> tensor_out
)
{
    uint idx = gi.x;
    if (idx >= pcs.numel) return;

    uint idx_in = 0;
    uint idx_out = 0;
    uint linear_idx = idx;

    [unroll]
    for (int i = 0; i < ndim; i++) {
        uint next_linear_idx = fast_div(linear_idx, pcs.sizes, i);
        uint coord = linear_idx - (next_linear_idx * pcs.sizes.divisor[i]);
        linear_idx = next_linear_idx;
        idx_in += coord * pcs.strides_in[i];
        idx_out += coord * pcs.strides_out[i];
    }

    tensor_out[idx_out] = Op.eval(tensor_in[idx_in]);
}

[[vk::binding(0, 0)]] StructuredBuffer<vector<{{ d1 }}, {{ v1 }}>> tensor_in_contig;
[[vk::binding(1, 0)]] RWStructuredBuffer<vector<{{ d1 }}, {{ v1 }}>> tensor_out_contig;

[[vk::binding(0, 0)]] StructuredBuffer<{{ d1 }}> tensor_in_noncontig;
[[vk::binding(1, 0)]] RWStructuredBuffer<{{ d1 }}> tensor_out_noncontig;

[shader("compute")]
[numthreads(WG_x, 1, 1)]
void main(uint3 gi: SV_DispatchThreadID) {

    {% for is_contig in [true, false] %}
    {% for op in OPERATIONS %}
    {% if 'float' in d1 or not op.get('float_only') %}

    {% if is_contig %}

    if (IS_CONTIG != 0 && OP_TYPE == {{ op['name'] }}) baseUnaryKernel<{{ d1 }}, {{ v1 }}, {{ op['struct'] }}<{{ d1 }}>>(
        gi, tensor_in_contig, tensor_out_contig
    );

    {% else %}

    {% for dim in range(MAX_DIMS+1) %}
    if (IS_CONTIG == 0 && OP_TYPE == {{ op['name'] }} && NDIM == {{ dim }}) baseUnaryKernel<{{ d1 }}, {{ dim }}, {{ op['struct'] }}<{{ d1 }}>>(
        gi, tensor_in_noncontig, tensor_out_noncontig
    );
    {% endfor %}

    {% endif %}

    {% endif %}
    {% endfor %}
    {% endfor %}
}
