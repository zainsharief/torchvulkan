{% include "helpers/int_divider.slang.j2" %}

[[vk::constant_id(0)]] const uint OP_TYPE = 0;
[[vk::constant_id(1)]] const uint NDIM = 0;
[[vk::constant_id(2)]] const uint WG_x = 0;

struct Metadata
{
    uint64_t sizes;
    uint64_t strides_in;
};

struct PushConstants
{
    uint64_t tensor_in;
    uint64_t tensor_out;
    uint64_t metadata;
    uint64_t num_lines;
    uint reduce_stride;
    uint reduce_size;
};

[[vk::push_constant]] ConstantBuffer<PushConstants> pcs;

void argReduceKernel(
    uint3 gi: SV_DispatchThreadID,
    uint64_t address_in,
    uint64_t address_out,
    uint64_t address_metadata,
    uint64_t num_lines,
    uint reduce_stride,
    uint reduce_size
)
{
    uint idx = gi.x;
    if (idx >= num_lines || reduce_size == 0) return;

    {{ d1 }}* tensor_in = ({{ d1 }}*)address_in;
    int64_t* tensor_out = (int64_t*)address_out;

    Metadata md = *(Metadata*)address_metadata;
    uint* strides_in = (uint*)md.strides_in;

    uint idx_in = 0;
    uint linear_idx = idx;

    for (uint i = 0; i < NDIM; i++)
    {
        uint next_linear_idx = fast_div(md.sizes, linear_idx, i, NDIM);
        uint divisor = get_divisor(md.sizes, i);
        uint coord = linear_idx - (next_linear_idx * divisor);
        linear_idx = next_linear_idx;
        idx_in += coord * strides_in[i];
    }

    {{ d1 }} best = tensor_in[idx_in];
    uint best_idx = 0;

    for (uint j = 1; j < reduce_size; j++)
    {
        {% if 'float' in d1 %}
        if (isnan(best)) break;
        {% endif %}

        {{ d1 }} v = tensor_in[idx_in + j * reduce_stride];
        bool take;

        {% if 'float' in d1 %}
        if (isnan(v)) take = true;
        else take = (OP_TYPE == 0) ? (v > best) : (v < best);
        {% else %}
        take = (OP_TYPE == 0) ? (v > best) : (v < best);
        {% endif %}

        if (take) { best = v; best_idx = j; }
    }

    tensor_out[idx] = int64_t(best_idx);
}

[shader("compute")]
[numthreads(WG_x, 1, 1)]
void main(uint3 gi: SV_DispatchThreadID)
{
    argReduceKernel(gi, pcs.tensor_in, pcs.tensor_out, pcs.metadata, pcs.num_lines, pcs.reduce_stride, pcs.reduce_size);
}
