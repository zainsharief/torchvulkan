{% include "helpers/int_divider.slang.j2" %}
{% include "helpers/vulkan_arithmetic.slang.j2" %}

[[vk::constant_id(0)]] const uint OP_TYPE = 0;
[[vk::constant_id(1)]] const uint NDIM = 0;
[[vk::constant_id(2)]] const uint WG_x = 0;

struct Metadata
{
    uint64_t sizes;
    uint64_t strides_in;
};

struct PushConstants
{
    uint64_t tensor_in;
    uint64_t tensor_out;
    uint64_t metadata;
    uint64_t numel_out;
    uint reduce_stride;
    uint reduce_size;
};

[[vk::push_constant]] ConstantBuffer<PushConstants> pcs;

interface IReduceOp<T>
{
    static T identity();
    static T combine(T a, T b);
    static T wave_reduce(T a);
}

struct SumReduceOp : IReduceOp<{{ d1 }}>
{
    static {{ d1 }} identity() { return {{ d1 }}.ext_zero(); }
    static {{ d1 }} combine({{ d1 }} a, {{ d1 }} b) { return {{ d1 }}.ext_add(a, b); }
    static {{ d1 }} wave_reduce({{ d1 }} a) { return WaveActiveSum(a); }
}

struct AmaxReduceOp : IReduceOp<{{ d1 }}>
{
    static {{ d1 }} identity() { return {{ d1 }}.ext_lowest(); }
    static {{ d1 }} combine({{ d1 }} a, {{ d1 }} b) { return {{ d1 }}.ext_max(a, b); }
    static {{ d1 }} wave_reduce({{ d1 }} a) { return WaveActiveMax(a); }
}

struct AminReduceOp : IReduceOp<{{ d1 }}>
{
    static {{ d1 }} identity() { return {{ d1 }}.ext_highest(); }
    static {{ d1 }} combine({{ d1 }} a, {{ d1 }} b) { return {{ d1 }}.ext_min(a, b); }
    static {{ d1 }} wave_reduce({{ d1 }} a) { return WaveActiveMin(a); }
}

void baseSubgroupReduceKernel<
    T,
    Op : IReduceOp<T>
>(
    uint out_idx,
    uint lane,
    uint64_t address_in,
    uint64_t address_out,
    uint64_t address_metadata,
    uint64_t numel_out,
    uint reduce_stride,
    uint reduce_size
)
{
    if (out_idx >= numel_out) return;

    T* tensor_in = (T*)address_in;
    T* tensor_out = (T*)address_out;

    Metadata md = *(Metadata*)address_metadata;
    uint* strides_in = (uint*)md.strides_in;

    uint idx_in = 0;
    uint linear_idx = out_idx;

    for (uint i = 0; i < NDIM; i++) 
    {
        uint next_linear_idx = fast_div(md.sizes, linear_idx, i, NDIM);
        uint divisor = get_divisor(md.sizes, i);
        uint coord = linear_idx - (next_linear_idx * divisor);
        linear_idx = next_linear_idx;
        idx_in += coord * strides_in[i];
    }

    T acc = Op.identity();
    for (uint r = lane; r < reduce_size; r += WG_x) {
        acc = Op.combine(acc, tensor_in[idx_in + r * reduce_stride]);
    }
    acc = Op.wave_reduce(acc);

    if (lane == 0) tensor_out[out_idx] = acc;
}

[shader("compute")]
[numthreads(WG_x, 1, 1)]
void main(uint3 group_id: SV_GroupID, uint3 group_thread_id: SV_GroupThreadID) {

    {% for op in OPERATIONS %}
    if (OP_TYPE == {{ op['name'] }}) baseSubgroupReduceKernel<{{ d1 }}, {{ op['struct'] }}>(
        group_id.x, group_thread_id.x, pcs.tensor_in, pcs.tensor_out, pcs.metadata, pcs.numel_out, pcs.reduce_stride, pcs.reduce_size
    );
    {% endfor %}
}
